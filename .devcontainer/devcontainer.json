{
  "name": "C++ Dev (Debian 13 / GCC 14)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-extension-pack",
        "ms-vscode.cmake-tools",
        "twxs.cmake",
        "ms-vscode.cpptools-themes",
        "zachflower.uncrustify"
      ],
      "settings": {
        "cmake.generator": "Ninja",
        "cmake.configureOnOpen": true,
        "C_Cpp.default.cppStandard": "c++17",
        "C_Cpp.default.compilerPath": "/usr/bin/g++"
      }
    }
  },
  "mounts": [
    // Cache vcpkg downloads across rebuilds
    "source=vcpkg-downloads,target=/opt/vcpkg/downloads,type=volume"
  ],
  "remoteEnv": {
    "VCPKG_ROOT": "/opt/vcpkg",
    "BUILDROOT_ROOT": "/opt/buildroot"
  },
  "postCreateCommand": "cmake --version && gcc --version && echo 'vcpkg: '$(vcpkg version 2>/dev/null | head -1)"
}
